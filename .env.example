# The Rodeo uses a SEPARATE Supabase project. Vite only exposes VITE_* to the
# browser. Put these in .env.local for dev (never commit real keys).
VITE_RODEO_SUPABASE_URL=https://YOUR-RODEO-REF.supabase.co
VITE_RODEO_SUPABASE_ANON_KEY=YOUR-RODEO-ANON-KEY

# Cloudflare Turnstile site key for the public comment form on /the-rodeo.
# This is the public site key, safe to commit/expose - the matching secret
# key lives only server-side, as the rodeo-comment edge function's
# TURNSTILE_SECRET (set via `supabase secrets set`, never in this file).
VITE_RODEO_TURNSTILE_SITE_KEY=YOUR-TURNSTILE-SITE-KEY
